        "messages": {
          "values": [
            {
              "content": "=Extraé los datos clave de este email de un cliente que pide una propuesta comercial. Respondé SOLO con un JSON válido, sin texto adicional, con este formato exacto:\n\n{\"cliente\": \"nombre de quien escribe\", \"email\": \"email del remitente\", \"pedido\": \"resumen de qué necesita el cliente en 1-2 frases\", \"urgencia\": \"alta/media/baja\"}\n\nEmail del cliente:\nAsunto: {{ $json.subject }}\nDe: {{ $json.headers.from }}\nCuerpo: {{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
